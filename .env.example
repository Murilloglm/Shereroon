# Copie para ".env" (na raiz) e ajuste. O arquivo .env nunca vai para o GitHub.
# Em desenvolvimento local nada disso é obrigatório: sem .env, o servidor usa o
# LiveKit local (npm run livekit) com as credenciais padrão do modo --dev.

# --- LiveKit (SFU + sinalização + TURN) -------------------------------------
# Endereço público que os NAVEGADORES usam para conectar (wss:// em produção).
LIVEKIT_URL=ws://localhost:7880
# Credenciais da API. São SEGREDOS: ficam só no backend, nunca no frontend.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Backend de salas ---------------------------------------------------------
PORT=8787
# Chave usada para assinar convites, sessões e a chave do dono da sala.
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Se trocar esta chave, todos os links de convite antigos deixam de funcionar.
APP_SECRET=
# A mesma chave protege o MFA da Administração Cosmic. Preserve-a entre deploys.
# Inicialização segura da conta Mg e recuperação: docs/cosmic-admin.md.
# Não configure senhas de bootstrap permanentemente neste arquivo ou no Git.
# Origens (sites) autorizadas a chamar a API, separadas por vírgula.
# Para GitHub Pages use só a origem, sem o caminho:  https://SEU-USUARIO.github.io
ALLOWED_ORIGINS=http://localhost:5173
# Use "1" quando o backend estiver atrás de um proxy confiável (Render, Fly, Caddy...).
TRUST_PROXY=0
# Validade do token de entrada na sala, em segundos (o LiveKit renova sozinho depois).
TOKEN_TTL_SECONDS=600

# --- Contas e grupos ----------------------------------------------------------
# Endereço do PostgreSQL (é um SEGREDO: contém a senha do banco). Exemplo:
#   postgresql://usuario:senha@servidor.exemplo.com/shareroom?sslmode=require
# No uso local pode ficar vazio: o servidor guarda os dados em server/.data com o PGlite.
# Em produção, sem este valor, contas e grupos ficam desligados e só as salas por link funcionam.
DATABASE_URL=

# --- Arquivos do chat ---------------------------------------------------------
# Os arquivos enviados nos canais ficam no banco de dados. Limites em megabytes.
# Tamanho máximo de cada arquivo (padrão 10, teto 50).
MAX_FILE_MB=10
# Quanto cada grupo pode guardar no total (padrão 400).
GROUP_STORAGE_MB=400
